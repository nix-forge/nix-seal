{
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.invocationStrategy": "once",
  "rust-analyzer.check.overrideCommand": [
    "nix",
    "develop",
    "--command",
    "cargo",
    "clippy",
    "--workspace",
    "--all-targets",
    "--all-features",
    "--locked",
    "--message-format=json",
    "--",
    "-D",
    "warnings"
  ],
  "rust-analyzer.checkOnSave": true
}
